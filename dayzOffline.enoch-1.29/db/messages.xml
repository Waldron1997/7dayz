<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<messages>
<!--
See https://community.bistudio.com/wiki/DayZ:Server_Messages for more information

Example messages:

1) following message will be displayed to every player in countdown manner
    and shuts down server in 10 hours from its start

    <message>
        <deadline>600</deadline>
        <shutdown>1</shutdown>
        <text>#name will shutdown in #tmin minutes.</text>
    </message>


2) following message will be displayed every 15 minutes to every player

    <message>
        <repeat>15</repeat>
        <text>You're playing on my server (#name). Thank you .)</text>
    </message>


3) following message will be displayed every 50 minutes to every player
    and 10 minutes after player connect

    <message>
        <delay>10</delay>
        <repeat>50</repeat>
        <onconnect>1</onconnect>
        <text>Check our web page at www.dayz.com</text>
    </message>


4) following message will be displayed once
    and 2 minutes after player connect

    <message>
        <delay>2</delay>
        <onconnect>1</onconnect>
        <text>Welcome to my server #name</text>
    </message>
    -->
<message>
        <deadline>360</deadline>
        <shutdown>1</shutdown>
        <text>28 Dayz Later will shutdown in #tmin minutes.</text>
    </message>
    
    <message>
        <delay>1</delay>
        <onconnect>1</onconnect>
        <text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</text>
    </message>
<message>
        <delay>1</delay>
        <onconnect>1</onconnect>
        <text>               W E L C O M E  T O  2 8  D A Y Z  L A T E R               </text>
    </message>
    <message>
        <delay>1</delay>
        <onconnect>1</onconnect>
         <text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</text>
    </message>
    <message>
      <repeat>60</repeat>
         <text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</text>
    </message>
    <message>
      <repeat>60</repeat>
        <text>LOGGING WITHIN 300m OF HIGH VALUE LOOT AREAS WILL BE FLAGGED TO ADMIN</text>
    </message>
    <message>
      <repeat>60</repeat>
        <text>SEE #RULES IN DISCORD FOR ALL RULES AROUND LOGGING. NO LOGGING ABUSE PLEASE!</text>
    </message>
    <message>
      <repeat>60</repeat>
        <text>* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *</text>
    </message>
    <message>
        <repeat>45</repeat>
        <text> Server Runtime is 4pm - 3am Mon-Fri, 9am - 3am Sat-Sun - UK TIME </text>
